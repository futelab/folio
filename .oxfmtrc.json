{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "ignorePatterns": [
    "**/dist/**",
    "node_modules/**",
    ".tmp/**",
    "test-results/**",
    "playwright-report/**",
    "coverage/**",
    "pnpm-lock.yaml",
    "packages/folio/styles.css"
  ]
}
