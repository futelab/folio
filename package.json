{
  "name": "folio-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "demo": "pnpm --filter @futelab/folio-demo dev --host 127.0.0.1 --port 55399",
    "dev": "turbo run dev --parallel",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-versions.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release": "pnpm check && pnpm test:e2e && pnpm test:package && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-spawn": "^7.0.6",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
