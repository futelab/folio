{
  "name": "@futelab/folio-react",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --external react --external react-dom",
    "test": "vitest run --passWithNoTests --root ../.. packages/react/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@futelab/folio-core": "workspace:*",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-collaboration": "^3.23.6",
    "@tiptap/extension-drag-handle": "^3.23.6",
    "@tiptap/extension-drag-handle-react": "^3.23.6",
    "@tiptap/extension-node-range": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/y-tiptap": "^3.0.4",
    "lucide-react": "^1.17.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsup": "^8.4.0"
  }
}
